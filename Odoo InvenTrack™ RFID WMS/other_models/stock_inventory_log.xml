<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_stock_inventory_log_tree" model="ir.ui.view">
        <field name="name">stock.inventory.log.tree</field>
        <field name="model">stock.inventory.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="user_id"/>
                <field name="inventory_date"/>
                <field name="company_id"/>
                <field name="state" widget="badge" decoration-danger="state == 'error'" decoration-success="state == 'success'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_inventory_log_form" model="ir.ui.view">
        <field name="name">stock.inventory.log.form</field>
        <field name="model">stock.inventory.log</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
<!--                <header>-->
<!--                    <button name="action_done" string="传输" type="object" class="btn btn-danger" invisible="1"/>-->
<!--                </header>-->
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="inventory_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inventory Lines">
                            <field name="log_line">
                                <list editable="bottom" no_open="1" create="0" delete="0">
                                    <field name="quant_id" invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state in ('notice', 'danger')"
                                           decoration-muted="state == 'delete'"
                                           decoration-success="state == 'success'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_inventory_log_search" model="ir.ui.view">
        <field name="name">stock.inventory.log.search</field>
        <field name="model">stock.inventory.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
            </search>
        </field>
    </record>

    <record id="action_stock_inventory_log" model="ir.actions.act_window">
        <field name="name">Inventory Adjustments</field>
        <field name="res_model">stock.inventory.log</field>
        <field name="view_mode">list,form,search</field>
    </record>

</odoo>