<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rfid_tag_tree_view" model="ir.ui.view">
        <field name="name">rfid.tag.tree</field>
        <field name="model">rfid.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="epc"/>
                <field name="reader_serial"/>
                <field name="timestamp"/>
                <field name="status" decoration-danger="status == 'error'" decoration-success="status == 'success'"/>
            </list>
        </field>
    </record>

    <record id="rfid_tag_action" model="ir.actions.act_window">
        <field name="name">RFID Tag</field>
        <field name="res_model">rfid.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="rfid_tag_menu" name="RFID Tag" parent="stock.menu_stock_inventory_control" action="rfid_tag_action"/>
</odoo>